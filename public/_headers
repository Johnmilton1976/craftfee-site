# Cloudflare Pages headers
# Applies to every response.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Static assets rarely change: cache hard.
# IMPORTANT: because of "immutable", browsers keep these files for a year and
# will NOT re-check them. Whenever style.css or calculator.js changes, bump the
# ?v=N query on its <link>/<script> tag so visitors get the new copy.
# See 部署操作清单.md → "Changing a shared asset".
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is text/html by default; keep it short-cached so rate updates go live fast.
/*.html
  Cache-Control: public, max-age=3600

# Search-engine files: always revalidate.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

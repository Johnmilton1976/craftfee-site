# Cloudflare Pages headers
# Applies to every response.
#
# Deliberately no X-Frame-Options. It only accepts DENY or SAMEORIGIN, and both
# make the calculators impossible to embed - which defeats the entire ?embed=1
# mode. frame-ancestors is the modern replacement: it names which origins may
# frame us, and * includes plain-http pages. A blog on http embedding our
# https frame is a normal mixed-content case, and restricting it only loses
# embeds without buying any protection: these pages have no login, no
# checkout, no writes, and no session.

/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors *
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Static assets rarely change: cache hard.
# IMPORTANT: because of "immutable", browsers keep these files for a year and
# will NOT re-check them. Whenever style.css or calculator.js changes, bump the
# ?v=N query on its <link>/<script> tag so visitors get the new copy.
# See 部署操作清单.md → "Changing a shared asset".
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is text/html by default; keep it short-cached so rate updates go live fast.
/*.html
  Cache-Control: public, max-age=3600

# Search-engine files: always revalidate.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
